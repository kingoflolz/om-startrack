# The app has no reflection-based application code. Android framework entry points
# are retained by the default Android rules generated by AGP.

# The Rust JNI bridge uses name-based exported symbols and constructs its result
# and exception types by binary class name. Keep this deliberately narrow ABI
# stable across R8 release builds.
-keep class dev.omshutter.plate.NativeTetra3Bridge { *; }
-keep class dev.omshutter.plate.NativeSolveResult { *; }
-keep class dev.omshutter.plate.NativeTetra3Exception { *; }
